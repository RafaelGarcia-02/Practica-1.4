# Variables para la base de datos
DB_ROOT_PASS="TuContraseñaSeguraParaRoot"
DB_USER="lamp_user"
DB_PASS="ContraseñaDelUsuarioWeb"
DB_NAME="lamp_db"

# Variables para la aplicación web
REPO_URL="https://github.com/josejuansanchez/iaw-practica-lamp.git"
DIR_TEMP="/tmp/iaw-practica-lamp"

# Variables para el Certificado SSL Autofirmado
OPENSSL_COUNTRY="ES"
OPENSSL_PROVINCE="Almeria"
OPENSSL_LOCALITY="Almeria"
OPENSSL_ORGANIZATION="IES Celia"
OPENSSL_ORGUNIT="Departamento de Informatica"
OPENSSL_COMMON_NAME="practica-https.local"
OPENSSL_EMAIL="admin@iescelia.org"